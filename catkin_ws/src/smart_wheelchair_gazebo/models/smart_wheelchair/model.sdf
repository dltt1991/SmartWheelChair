<?xml version="1.0"?>
<sdf version="1.6">
  <model name="smart_wheelchair">
    <pose>0 0 0 0 0 0</pose>

    <link name="base_link">
      <inertial>
        <mass>65.0</mass>
        <inertia>
          <ixx>3.0</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>4.0</iyy><iyz>0</iyz>
          <izz>3.0</izz>
        </inertia>
      </inertial>

      <collision name="base_collision">
        <pose>0 0 0.42 0 0 0</pose>
        <geometry><box><size>0.95 0.62 0.18</size></box></geometry>
      </collision>
      <visual name="base_visual">
        <pose>0 0 0.42 0 0 0</pose>
        <geometry><box><size>0.95 0.62 0.18</size></box></geometry>
        <material><ambient>0.06 0.07 0.08 1</ambient><diffuse>0.06 0.07 0.08 1</diffuse></material>
      </visual>

      <visual name="seat_visual">
        <pose>-0.12 0 0.68 0 0 0</pose>
        <geometry><box><size>0.60 0.58 0.09</size></box></geometry>
        <material><ambient>0.015 0.017 0.02 1</ambient><diffuse>0.015 0.017 0.02 1</diffuse></material>
      </visual>

      <visual name="backrest_visual">
        <pose>-0.43 0 1.00 0 -0.18 0</pose>
        <geometry><box><size>0.09 0.58 0.70</size></box></geometry>
        <material><ambient>0.015 0.017 0.02 1</ambient><diffuse>0.015 0.017 0.02 1</diffuse></material>
      </visual>

      <visual name="left_armrest_visual">
        <pose>-0.10 0.36 0.83 0 0 0</pose>
        <geometry><box><size>0.62 0.06 0.08</size></box></geometry>
        <material><ambient>0.08 0.09 0.10 1</ambient><diffuse>0.08 0.09 0.10 1</diffuse></material>
      </visual>

      <visual name="right_armrest_visual">
        <pose>-0.10 -0.36 0.83 0 0 0</pose>
        <geometry><box><size>0.62 0.06 0.08</size></box></geometry>
        <material><ambient>0.08 0.09 0.10 1</ambient><diffuse>0.08 0.09 0.10 1</diffuse></material>
      </visual>

      <visual name="left_arm_support_front_visual">
        <pose>0.16 0.36 0.67 0 0 0</pose>
        <geometry><box><size>0.045 0.045 0.28</size></box></geometry>
        <material><ambient>0.16 0.18 0.19 1</ambient><diffuse>0.16 0.18 0.19 1</diffuse></material>
      </visual>

      <visual name="right_arm_support_front_visual">
        <pose>0.16 -0.36 0.67 0 0 0</pose>
        <geometry><box><size>0.045 0.045 0.28</size></box></geometry>
        <material><ambient>0.16 0.18 0.19 1</ambient><diffuse>0.16 0.18 0.19 1</diffuse></material>
      </visual>

      <visual name="footplate_visual">
        <pose>0.48 0 0.30 0 0 0</pose>
        <geometry><box><size>0.32 0.48 0.045</size></box></geometry>
        <material><ambient>0.12 0.13 0.14 1</ambient><diffuse>0.12 0.13 0.14 1</diffuse></material>
      </visual>

      <visual name="left_frame_rail_visual">
        <pose>0.02 0.31 0.52 0 0 0</pose>
        <geometry><box><size>0.86 0.035 0.06</size></box></geometry>
        <material><ambient>0.13 0.15 0.16 1</ambient><diffuse>0.13 0.15 0.16 1</diffuse></material>
      </visual>

      <visual name="right_frame_rail_visual">
        <pose>0.02 -0.31 0.52 0 0 0</pose>
        <geometry><box><size>0.86 0.035 0.06</size></box></geometry>
        <material><ambient>0.13 0.15 0.16 1</ambient><diffuse>0.13 0.15 0.16 1</diffuse></material>
      </visual>

      <visual name="battery_visual">
        <pose>-0.15 0 0.27 0 0 0</pose>
        <geometry><box><size>0.42 0.44 0.12</size></box></geometry>
        <material><ambient>0.08 0.09 0.10 1</ambient><diffuse>0.08 0.09 0.10 1</diffuse></material>
      </visual>


      <visual name="left_lidar_body_visual">
        <pose>0.46 0.26 0.56 0 0 0</pose>
        <geometry><box><size>0.10 0.08 0.055</size></box></geometry>
        <material><ambient>0.02 0.30 0.18 1</ambient><diffuse>0.02 0.30 0.18 1</diffuse></material>
      </visual>

      <visual name="right_lidar_body_visual">
        <pose>0.46 -0.26 0.56 0 0 0</pose>
        <geometry><box><size>0.10 0.08 0.055</size></box></geometry>
        <material><ambient>0.02 0.30 0.18 1</ambient><diffuse>0.02 0.30 0.18 1</diffuse></material>
      </visual>

      <visual name="left_lidar_ray_minus50_visual">
        <pose>0.910 -0.276 0.660 0 0 -0.8727</pose>
        <geometry><box><size>1.40 0.018 0.012</size></box></geometry>
        <material><ambient>0.0 0.9 0.48 0.38</ambient><diffuse>0.0 0.9 0.48 0.38</diffuse></material>
      </visual>

      <visual name="left_lidar_ray_0_visual">
        <pose>1.160 0.260 0.660 0 0 0.0000</pose>
        <geometry><box><size>1.40 0.018 0.012</size></box></geometry>
        <material><ambient>0.0 0.9 0.48 0.38</ambient><diffuse>0.0 0.9 0.48 0.38</diffuse></material>
      </visual>

      <visual name="left_lidar_ray_50_visual">
        <pose>0.910 0.796 0.660 0 0 0.8727</pose>
        <geometry><box><size>1.40 0.018 0.012</size></box></geometry>
        <material><ambient>0.0 1.0 0.55 0.50</ambient><diffuse>0.0 1.0 0.55 0.50</diffuse></material>
      </visual>

      <visual name="left_lidar_ray_100_visual">
        <pose>0.338 0.949 0.660 0 0 1.7453</pose>
        <geometry><box><size>1.40 0.018 0.012</size></box></geometry>
        <material><ambient>0.0 0.9 0.48 0.38</ambient><diffuse>0.0 0.9 0.48 0.38</diffuse></material>
      </visual>

      <visual name="left_lidar_ray_150_visual">
        <pose>-0.146 0.610 0.660 0 0 2.6180</pose>
        <geometry><box><size>1.40 0.018 0.012</size></box></geometry>
        <material><ambient>0.0 0.9 0.48 0.38</ambient><diffuse>0.0 0.9 0.48 0.38</diffuse></material>
      </visual>

      <visual name="right_lidar_ray_minus150_visual">
        <pose>-0.146 -0.610 0.660 0 0 -2.6180</pose>
        <geometry><box><size>1.40 0.018 0.012</size></box></geometry>
        <material><ambient>0.0 0.9 0.48 0.38</ambient><diffuse>0.0 0.9 0.48 0.38</diffuse></material>
      </visual>

      <visual name="right_lidar_ray_minus100_visual">
        <pose>0.338 -0.949 0.660 0 0 -1.7453</pose>
        <geometry><box><size>1.40 0.018 0.012</size></box></geometry>
        <material><ambient>0.0 0.9 0.48 0.38</ambient><diffuse>0.0 0.9 0.48 0.38</diffuse></material>
      </visual>

      <visual name="right_lidar_ray_minus50_visual">
        <pose>0.910 -0.796 0.660 0 0 -0.8727</pose>
        <geometry><box><size>1.40 0.018 0.012</size></box></geometry>
        <material><ambient>0.0 1.0 0.55 0.50</ambient><diffuse>0.0 1.0 0.55 0.50</diffuse></material>
      </visual>

      <visual name="right_lidar_ray_0_visual">
        <pose>1.160 -0.260 0.660 0 0 0.0000</pose>
        <geometry><box><size>1.40 0.018 0.012</size></box></geometry>
        <material><ambient>0.0 0.9 0.48 0.38</ambient><diffuse>0.0 0.9 0.48 0.38</diffuse></material>
      </visual>

      <visual name="right_lidar_ray_50_visual">
        <pose>0.910 0.276 0.660 0 0 0.8727</pose>
        <geometry><box><size>1.40 0.018 0.012</size></box></geometry>
        <material><ambient>0.0 0.9 0.48 0.38</ambient><diffuse>0.0 0.9 0.48 0.38</diffuse></material>
      </visual>

      <sensor name="left_lidar" type="ray">
        <pose>0.46 0.26 0.56 0 0 0</pose>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>401</samples>
              <resolution>1</resolution>
              <min_angle>-0.87266</min_angle>
              <max_angle>2.61799</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.08</min>
            <max>5.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <plugin name="left_lidar_ros" filename="libgazebo_ros_laser.so">
          <robotNamespace>/</robotNamespace>
          <topicName>/scan_left</topicName>
          <frameName>left_lidar</frameName>
        </plugin>
        <always_on>true</always_on>
        <visualize>true</visualize>
      </sensor>

      <sensor name="right_lidar" type="ray">
        <pose>0.46 -0.26 0.56 0 0 0</pose>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>401</samples>
              <resolution>1</resolution>
              <min_angle>-2.61799</min_angle>
              <max_angle>0.87266</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.08</min>
            <max>5.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <plugin name="right_lidar_ros" filename="libgazebo_ros_laser.so">
          <robotNamespace>/</robotNamespace>
          <topicName>/scan_right</topicName>
          <frameName>right_lidar</frameName>
        </plugin>
        <always_on>true</always_on>
        <visualize>true</visualize>
      </sensor>

      <sensor name="rear_camera" type="camera">
        <pose>-0.58 0 0.72 0 0.60 3.1416</pose>
        <update_rate>15</update_rate>
        <camera>
          <horizontal_fov>2.094</horizontal_fov>
          <image>
            <width>640</width>
            <height>360</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>10.0</far>
          </clip>
        </camera>
        <plugin name="rear_camera_ros" filename="libgazebo_ros_camera.so">
          <robotNamespace>/</robotNamespace>
          <cameraName>camera/rear</cameraName>
          <imageTopicName>image</imageTopicName>
          <cameraInfoTopicName>camera_info</cameraInfoTopicName>
          <frameName>rear_camera</frameName>
        </plugin>
        <always_on>true</always_on>
      </sensor>
    </link>

    <link name="left_rear_wheel">
      <pose>-0.33 0.36 0.18 0 0 0</pose>
      <inertial><mass>2.0</mass><inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.02</izz></inertia></inertial>
      <collision name="collision"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.18</radius><length>0.07</length></cylinder></geometry></collision>
      <visual name="visual"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.18</radius><length>0.07</length></cylinder></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
      <visual name="left_rear_hub_visual"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.09</radius><length>0.08</length></cylinder></geometry><material><ambient>0.55 0.58 0.60 1</ambient><diffuse>0.55 0.58 0.60 1</diffuse></material></visual>
    </link>

    <link name="right_rear_wheel">
      <pose>-0.33 -0.36 0.18 0 0 0</pose>
      <inertial><mass>2.0</mass><inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.02</izz></inertia></inertial>
      <collision name="collision"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.18</radius><length>0.07</length></cylinder></geometry></collision>
      <visual name="visual"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.18</radius><length>0.07</length></cylinder></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
      <visual name="right_rear_hub_visual"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.09</radius><length>0.08</length></cylinder></geometry><material><ambient>0.55 0.58 0.60 1</ambient><diffuse>0.55 0.58 0.60 1</diffuse></material></visual>
    </link>

    <link name="left_front_caster">
      <pose>0.38 0.25 0.08 0 0 0</pose>
      <inertial><mass>0.6</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz></inertia></inertial>
      <collision name="collision"><geometry><sphere><radius>0.08</radius></sphere></geometry></collision>
      <visual name="visual"><geometry><sphere><radius>0.08</radius></sphere></geometry><material><ambient>0.05 0.05 0.055 1</ambient><diffuse>0.05 0.05 0.055 1</diffuse></material></visual>
      <visual name="left_caster_fork_visual"><pose>0 0 0.11 0 0 0</pose><geometry><box><size>0.05 0.12 0.12</size></box></geometry><material><ambient>0.55 0.58 0.60 1</ambient><diffuse>0.55 0.58 0.60 1</diffuse></material></visual>
    </link>

    <link name="right_front_caster">
      <pose>0.38 -0.25 0.08 0 0 0</pose>
      <inertial><mass>0.6</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz></inertia></inertial>
      <collision name="collision"><geometry><sphere><radius>0.08</radius></sphere></geometry></collision>
      <visual name="visual"><geometry><sphere><radius>0.08</radius></sphere></geometry><material><ambient>0.05 0.05 0.055 1</ambient><diffuse>0.05 0.05 0.055 1</diffuse></material></visual>
      <visual name="right_caster_fork_visual"><pose>0 0 0.11 0 0 0</pose><geometry><box><size>0.05 0.12 0.12</size></box></geometry><material><ambient>0.55 0.58 0.60 1</ambient><diffuse>0.55 0.58 0.60 1</diffuse></material></visual>
    </link>

    <link name="rear_axle">
      <pose>-0.33 0 0 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>0.000001</ixx><iyy>0.000001</iyy><izz>0.000001</izz></inertia>
      </inertial>
    </link>
    <joint name="rear_axle_joint" type="fixed">
      <parent>base_link</parent>
      <child>rear_axle</child>
    </joint>

    <joint name="left_rear_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_rear_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <joint name="right_rear_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_rear_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <joint name="left_front_caster_joint" type="ball">
      <parent>base_link</parent>
      <child>left_front_caster</child>
    </joint>

    <joint name="right_front_caster_joint" type="ball">
      <parent>base_link</parent>
      <child>right_front_caster</child>
    </joint>

    <plugin name="differential_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <robotNamespace>/</robotNamespace>
      <alwaysOn>true</alwaysOn>
      <updateRate>50</updateRate>
      <leftJoint>left_rear_wheel_joint</leftJoint>
      <rightJoint>right_rear_wheel_joint</rightJoint>
      <wheelSeparation>0.72</wheelSeparation>
      <wheelDiameter>0.36</wheelDiameter>
      <commandTopic>/cmd_vel</commandTopic>
      <odometryTopic>/diff_drive/odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>rear_axle</robotBaseFrame>
      <publishWheelTF>false</publishWheelTF>
      <publishOdomTF>false</publishOdomTF>
      <odometrySource>world</odometrySource>
    </plugin>

    <!-- P3D measures the link itself; diff-drive world odometry measures the model origin. -->
    <plugin name="rear_axle_ground_truth" filename="libgazebo_ros_p3d.so">
      <robotNamespace>/</robotNamespace>
      <bodyName>rear_axle</bodyName>
      <topicName>/rear_axle_ground_truth</topicName>
      <frameName>world</frameName>
      <localTwist>true</localTwist>
      <updateRate>50</updateRate>
      <gaussianNoise>0</gaussianNoise>
    </plugin>

    <plugin filename="libSmartWheelChairTrajectoryPreview.so" name="smart_wheelchair_gazebo::TrajectoryPreviewPlugin">
      <cmd_topic>/cmd_vel_raw</cmd_topic>
      <filtered_cmd_topic>/cmd_vel</filtered_cmd_topic>
      <prediction_seconds>3.0</prediction_seconds>
      <step_seconds>0.3</step_seconds>
      <command_timeout_s>0.5</command_timeout_s>
      <rear_axle_x_m>-0.33</rear_axle_x_m>
      <wheel_separation_m>0.72</wheel_separation_m>
      <z_m>0.18</z_m>
    </plugin>
  </model>
</sdf>
