<?xml version="1.0"?>
<package format="2">
  <name>smart_wheelchair_safety</name>
  <version>0.1.0</version>
  <description>Unified shared controller for the smart wheelchair simulator.</description>
  <maintainer email="dev@example.com">SmartWheelChair</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>geometry_msgs</depend>
