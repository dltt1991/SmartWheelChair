<launch>
  <test pkg="smart_wheelchair_safety" type="test_joystick.py"
        test-name="joystick" time-limit="60" />
  <test pkg="smart_wheelchair_safety" type="test_unified_geometry.py"
        test-name="unified_geometry" time-limit="180" />
  <test pkg="smart_wheelchair_safety" type="test_local_path_follower.py"
        test-name="local_path_follower" time-limit="60" />
  <group ns="web_and_follower_regression">
    <include file="$(find smart_wheelchair_safety)/test/web_and_follower.test" />
  </group>
  <include file="$(find smart_wheelchair_safety)/test/unified_control.test" />
  <test pkg="smart_wheelchair_safety" type="test_wall_end.py"
        test-name="wall_end" time-limit="60" />
</launch>
