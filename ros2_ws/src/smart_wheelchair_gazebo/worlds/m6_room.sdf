<?xml version="1.0"?>
<sdf version="1.10">
  <world name="m6_room">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name="sun" type="directional">
      <pose>0 0 6 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>8 6 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>8 6 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.70 1</ambient>
            <diffuse>0.75 0.75 0.70 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="doorway_left_wall">
      <static>true</static>
      <pose>2.0 0.85 0.55 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 1.9 1.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 1.9 1.1</size></box></geometry>
          <material><ambient>0.35 0.38 0.42 1</ambient><diffuse>0.35 0.38 0.42 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="doorway_right_wall">
      <static>true</static>
      <pose>2.0 -0.85 0.55 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 1.9 1.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 1.9 1.1</size></box></geometry>
          <material><ambient>0.35 0.38 0.42 1</ambient><diffuse>0.35 0.38 0.42 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://smart_wheelchair</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
